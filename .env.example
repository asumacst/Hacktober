# Copia este archivo a .env y completa los valores. .env está en .gitignore: nunca lo subas.
# Nombres propuestos por el Rol D; el Rol A confirma los que use el cliente de Gemma.

# Clave de la Gemini API (Google AI Studio). Solo se lee en el servidor, nunca en el navegador.
GEMINI_API_KEY=

# Modelo Gemma 4 vía Gemini API (decisión en docs/decisions.md).
# Respaldo si falla o se agota la cuota: gemma-4-31b-it
GEMINI_MODEL=gemma-4-26b-a4b-it

# Modo de la interfaz: mock (respuestas de ejemplo etiquetadas) o live (orquestador real).
RECICLACLARO_UI_MODE=mock

# 1 = la capa de IA devuelve su muestra etiquetada como MOCK, sin red ni clave.
# Solo para desarrollo o respaldo; la demo del reto usa 0 (llamada real).
RECICLACLARO_AI_MOCK=0
